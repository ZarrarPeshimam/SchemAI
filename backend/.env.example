# Copy to backend/.env and fill in. NEVER commit backend/.env.
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Required for POST /api/schema/generate. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Model used for generation. Default: gemini-3.8-flash
# (gemini-2.5-* models are being retired by Google in Oct 2026 - avoid them.)
GEMINI_MODEL=gemini-flash-latest

# Optional. Per-request timeout in ms (default 60000). A repair attempt may make a 2nd request.
GEMINI_TIMEOUT_MS=180000
